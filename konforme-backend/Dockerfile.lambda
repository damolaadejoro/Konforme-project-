# Container image for AWS Lambda. The same image backs the api, worker and
# migrate functions; Terraform picks the handler via image_config.command.
#
# Build from the repository root (the backend reads ../data):
#   docker build -f konforme-backend/Dockerfile.lambda .
FROM public.ecr.aws/lambda/python:3.12

COPY konforme-backend/requirements.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt

COPY konforme-backend/ ${LAMBDA_TASK_ROOT}/
# konforme-backend/data is a symlink to ../data, which does not exist inside the image
COPY data/ ${LAMBDA_TASK_ROOT}/data/

CMD ["lambda_handler.api"]
