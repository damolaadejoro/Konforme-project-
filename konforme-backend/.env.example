DATABASE_URL=sqlite:///./konforme.db
# IMPORTANT: Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
KONFORME_AWS_ACCOUNT_ID=123456789012
RATE_LIMIT_PER_MINUTE=60
ENVIRONMENT=development

# IMPORTANT: Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE

# JWT / Auth
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Cookie settings (set COOKIE_SECURE=true for production with HTTPS)
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database pool (PostgreSQL)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
